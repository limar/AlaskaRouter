# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored and auto-sourced by run.sh and the source fetchers;
# nothing here is ever committed. Each var is also accepted straight from the
# environment, so CI can `export RIDB_API_KEY=…` instead of using a file.

# RIDB / Recreation.gov API key — used by sources/fetch_ridb.py (Stage 3).
# Get a free key: https://ridb.recreation.gov/  →  sign in  →  Profile  →
# "API Key" (a UUID). No cost, no approval wait.
RIDB_API_KEY=
