<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Schemes we probe with canOpenURL when building the "Open in…" maps
	  chooser (AlaskaRouter-55pn). Without this allow-list, canOpenURL returns
	  false even when the app is installed, so the chooser would hide every
	  third-party app. Apple Maps isn't listed because it uses a universal
	  https link, not a custom scheme.

	  The rest of the Info.plist is still generated (GENERATE_INFOPLIST_FILE =
	  YES); Xcode merges the INFOPLIST_KEY_* build settings on top of this base.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>waze</string>
		<string>mapsme</string>
	</array>

	<!--
	  Lossless trip export/import (AlaskaRouter-h113). The exported UTI
	  `dev.alaskarouter.trip` (a JSON subtype, extension `.akrtrip`) lets Files,
	  AirDrop and the share sheet recognize the format and hand a tapped file
	  back to the app via .onOpenURL. CFBundleDocumentTypes registers the app as
	  an Owner/Editor of that type.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.alaskarouter.trip</string>
			<key>UTTypeDescription</key>
			<string>AlaskaRouter Trip</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>akrtrip</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/json</string>
				</array>
			</dict>
		</dict>
	</array>
	<!--
	  We can read a `.akrtrip` at its original location — TripFileImport wraps
	  the read in a start/stopAccessingSecurityScopedResource bracket and
	  materializes a *copy of the trip* in SwiftData, never writing back to the
	  file. So we declare in-place support: iOS hands us the original URL
	  instead of dropping a duplicate into Documents/Inbox on every open (which
	  nothing would ever clean up). Without this key the linker warns that the
	  app opens files but doesn't say how.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AlaskaRouter Trip</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.alaskarouter.trip</string>
			</array>
			<!--
			  Brand the .akrtrip file with the app icon (AlaskaRouter-h113)
			  instead of the white schematic default. Loose PNGs generated from
			  AppIcon.png and bundled at the resource root; iOS picks the best
			  size and applies its own document-corner framing.
			-->
			<key>CFBundleTypeIconFiles</key>
			<array>
				<string>TripDocumentIcon-320</string>
				<string>TripDocumentIcon-64</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
